<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡"
                android:textSize="56sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Electricity Bill Estimator"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#1B5E20"
                android:gravity="center"
                android:layout_marginTop="6dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Modern Firebase Mobile Application"
                android:textSize="17sp"
                android:textColor="#607D8B"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

        <!-- MAIN CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="24dp"
            android:elevation="8dp">

            <!-- PROFILE TITLE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👩‍💻 Student Profile"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#1B5E20"
                android:layout_gravity="center"
                android:layout_marginBottom="25dp"/>

            <!-- PROFILE IMAGE -->

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imageProfile"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center"
                android:layout_marginBottom="30dp"
                android:src="@drawable/shaza"
                android:scaleType="centerCrop"
                android:elevation="10dp"
                android:padding="4dp"
                android:background="@android:color/white"
                app:shapeAppearanceOverlay="@style/circleImage"
                app:strokeColor="#2E7D32"
                app:strokeWidth="3dp"/>

            <!-- FULL NAME -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F8FAFC"
                android:padding="18dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Full Name"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#757575"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NURSHAZA SYAUQINA BINTI NURSHARULHAMI"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:layout_marginTop="5dp"/>

            </LinearLayout>

            <!-- STUDENT ID -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F8FAFC"
                android:padding="18dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Student ID"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#757575"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2025129131"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:layout_marginTop="5dp"/>

            </LinearLayout>

            <!-- FACULTY -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F8FAFC"
                android:padding="18dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Faculty"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#757575"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CD - College of Computing, Informatics and Mathematics"
                    android:textSize="19sp"
                    android:textColor="#212121"
                    android:layout_marginTop="5dp"/>

            </LinearLayout>

            <!-- PROGRAMME -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F8FAFC"
                android:padding="18dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Programme"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#757575"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CDCS251 - Bachelor of Computing Science (Hons.) Netcentric Computing"
                    android:textSize="19sp"
                    android:textColor="#212121"
                    android:layout_marginTop="5dp"/>

            </LinearLayout>

            <!-- GITHUB -->

            <TextView
                android:id="@+id/tvGithub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔗 View GitHub Repository&#10;https://github.com/ssyauqina/ElectricityBillEstimator"
                android:textColor="#1565C0"
                android:textStyle="bold"
                android:textSize="18sp"
                android:gravity="center"
                android:padding="16dp"
                android:background="#E3F2FD"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="35dp"/>

            <!-- HOW TO USE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📱 How To Use Application"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#1B5E20"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Select your billing month.\n\n2. Enter electricity usage (1–1000 kWh).\n\n3. Adjust rebate percentage.\n\n4. Press CALCULATE to generate the bill.\n\n5. Press SAVE RECORD to store the bill in Firebase.\n\n6. Press VIEW HISTORY to view all saved records.\n\n7. Tap any bill card to view detailed information or delete a record."
                android:textSize="18sp"
                android:textColor="#424242"
                android:lineSpacingExtra="8dp"
                android:layout_marginBottom="35dp"/>

            <!-- COPYRIGHT -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="© 2026 ICT602 INDIVIDUAL ASSIGNMENT"
                android:textStyle="bold"
                android:textColor="#9E9E9E"
                android:textSize="15sp"
                android:layout_gravity="center"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>