<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FA"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- APP HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡"
                android:textSize="56sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Electricity Bill&#10;Estimator"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#1B5E20"
                android:gravity="center"
                android:layout_marginTop="6dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Modern Firebase Mobile Application"
                android:textSize="17sp"
                android:textColor="#607D8B"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

        <!-- MODERN INSTRUCTION CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="20dp"
            android:elevation="6dp"
            android:layout_marginBottom="22dp">

            <!-- TITLE -->

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡"
                    android:textSize="24sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Application Guide"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#1B5E20"/>
            </LinearLayout>

            <!-- STEP 1 -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="① Select your electricity bill month"
                android:textSize="15sp"
                android:textColor="#555555"
                android:layout_marginTop="18dp"
                android:lineSpacingExtra="2dp"/>

            <!-- STEP 2 -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="② Enter electricity usage unit (1 - 1000 kWh)"
                android:textSize="15sp"
                android:textColor="#555555"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="2dp"/>

            <!-- STEP 3 -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="③ Adjust rebate percentage using slider"
                android:textSize="15sp"
                android:textColor="#555555"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="2dp"/>

            <!-- STEP 4 -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="④ Press CALCULATE to estimate total bill"
                android:textSize="15sp"
                android:textColor="#555555"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="2dp"/>

            <!-- STEP 5 -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⑤ Save and view your bill history anytime"
                android:textSize="15sp"
                android:textColor="#555555"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="2dp"/>

        </LinearLayout>

        <!-- INPUT CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:elevation="5dp"
            android:padding="18dp"
            android:layout_marginBottom="22dp">

            <!-- MONTH -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Month"
                android:textStyle="bold"
                android:textSize="17sp"
                android:textColor="#333333"/>

            <Spinner
                android:id="@+id/spMonth"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="22dp"
                android:background="@drawable/spinner_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:spinnerMode="dropdown"/>

            <!-- UNIT -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Electricity Unit (1 - 1000)"
                android:textStyle="bold"
                android:textSize="17sp"
                android:textColor="#333333"/>

            <EditText
                android:id="@+id/etUnit"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:hint="Enter electricity unit"
                android:inputType="number"
                android:background="#F8F9FA"
                android:padding="14dp"
                android:textSize="16sp"
                android:layout_marginTop="8dp"/>

            <!-- NOTICE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="* Electricity unit allowed: 1 - 1000 kWh"
                android:textColor="#D32F2F"
                android:textSize="12sp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="22dp"/>

            <!-- REBATE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rebate Percentage"
                android:textStyle="bold"
                android:textSize="17sp"
                android:textColor="#333333"/>

            <SeekBar
                android:id="@+id/seekRebate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="5"/>

            <TextView
                android:id="@+id/tvRebate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#2E7D32"
                android:layout_marginBottom="22dp"/>

            <!-- CALCULATE BUTTON -->

            <Button
                android:id="@+id/btnCalculate"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="CALCULATE"
                android:textStyle="bold"
                android:textSize="17sp"
                android:letterSpacing="0.05"
                android:backgroundTint="#2E7D32"
                android:textColor="#FFFFFF"/>

            <!-- RESET BUTTON -->

            <Button
                android:id="@+id/btnReset"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="RESET"
                android:textStyle="bold"
                android:textSize="17sp"
                android:letterSpacing="0.05"
                android:backgroundTint="#757575"
                android:textColor="#FFFFFF"
                android:layout_marginTop="12dp"/>

        </LinearLayout>

        <!-- RESULT CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:elevation="5dp"
            android:padding="18dp"
            android:layout_marginBottom="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RESULT"
                android:textStyle="bold"
                android:textSize="25sp"
                android:textColor="#2E7D32"
                android:layout_marginBottom="22dp"/>

            <TextView
                android:id="@+id/tvTotalCharges"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Charges : RM 0.00"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tvFinalCost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Final Cost : RM 0.00"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#333333"/>

        </LinearLayout>

        <!-- SAVE BUTTON -->

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="SAVE RECORD"
            android:textStyle="bold"
            android:textSize="16sp"
            android:letterSpacing="0.05"
            android:backgroundTint="#1976D2"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="14dp"/>

        <!-- HISTORY BUTTON -->

        <Button
            android:id="@+id/btnHistory"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="VIEW HISTORY"
            android:textStyle="bold"
            android:textSize="16sp"
            android:letterSpacing="0.05"
            android:backgroundTint="#F57C00"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="14dp"/>

        <!-- ABOUT BUTTON -->

        <Button
            android:id="@+id/btnAbout"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="ABOUT"
            android:textStyle="bold"
            android:textSize="16sp"
            android:letterSpacing="0.05"
            android:backgroundTint="#7B1FA2"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

</ScrollView>